{
  "name": "panencia",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply panencia --local",
    "db:migrate:remote": "wrangler d1 migrations apply panencia --remote",
    "crear-usuario": "node scripts/crear-usuario.mjs",
    "test": "node --test --test-concurrency=1 test/api.test.mjs"
  },
  "devDependencies": {
    "wrangler": "4.141.0"
  }
}
